<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.soundy.player</id>

  <name>Soundy</name>
  <developer id="github.com.ganddtn40">
    <name>ganddtn40</name>
  </developer>
  <keywords>
    <keyword>music</keyword>
    <keyword>spotify</keyword>
    <keyword>audio</keyword>
    <keyword>player</keyword>
  </keywords>
  <summary>A lightweight native music player</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/ganddtn40/soundy</url>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <description>
    <p>
      Soundy is a lightweight native music player built with Rust and GPUI. It keeps the
      provider integrations, lyrics, artist pages, playlists and system media controls of the
      Sonora codebase it builds on.
    </p>
  </description>

  <content_rating type="oars-1.1" />

  <provides>
    <mediatype>audio/mpeg</mediatype>
    <mediatype>audio/flac</mediatype>
    <mediatype>audio/mp4</mediatype>
    <mediatype>audio/aac</mediatype>
    <mediatype>audio/ogg</mediatype>
    <mediatype>audio/opus</mediatype>
    <mediatype>audio/x-wav</mediatype>
    <mediatype>audio/x-aiff</mediatype>
    <mediatype>audio/webm</mediatype>
    <mediatype>audio/x-matroska</mediatype>
    <mediatype>audio/x-wavpack</mediatype>
    <mediatype>audio/x-ape</mediatype>
  </provides>

  <releases>
    <release version="1.0.1" date="2026-11-19">
      <description>
        <p>
          Public Spotify playlists now import from their link without an account, a sign-in or
          Premium. Soundy reads the public playlist page, keeps the published rows in order and
          fills in artwork and album names from public catalogues.
        </p>
      </description>
    </release>
  </releases>

  <launchable type="desktop-id">app.soundy.player.desktop</launchable>
</component>
